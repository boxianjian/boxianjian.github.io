/* =========================================================
   渲染
   ========================================================= */
const cv = $("grid"), ctx = cv.getContext("2d");
let dpr = 1;
function sizeCanvas(){
  dpr = Math.min(2, window.devicePixelRatio||1);
  cv.width = CW*dpr; cv.height = CH*dpr;
  cv.style.width = CW+"px"; cv.style.height = CH+"px";
  ctx.setTransform(dpr,0,0,dpr,0,0);
}
sizeCanvas();
window.addEventListener("resize", sizeCanvas);

let hover = null;

function drawShape(g, shape, cx, cy, s, hex, glow, alpha){
  g.save();
  g.translate(cx, cy);
  g.globalAlpha = alpha===undefined?1:alpha;
  g.shadowColor = hex; g.shadowBlur = glow;
  g.strokeStyle = hex; g.lineWidth = 2.4;
  const grd = g.createLinearGradient(-s,-s,s,s);
  grd.addColorStop(0, hex+"55"); grd.addColorStop(1, hex+"11");
  g.fillStyle = grd;
  g.beginPath();
  const h = s*0.78;
  if(shape==="square"){
    const q = h*0.22;
    g.moveTo(-h+q,-h); g.lineTo(h-q,-h); g.quadraticCurveTo(h,-h,h,-h+q);
    g.lineTo(h,h-q); g.quadraticCurveTo(h,h,h-q,h);
    g.lineTo(-h+q,h); g.quadraticCurveTo(-h,h,-h,h-q);
    g.lineTo(-h,-h+q); g.quadraticCurveTo(-h,-h,-h+q,-h);
  }else if(shape==="circle"){
    g.arc(0,0,h,0,Math.PI*2);
  }else if(shape==="triangle"){
    g.moveTo(0,-h); g.lineTo(h*0.92,h*0.7); g.lineTo(-h*0.92,h*0.7); g.closePath();
  }else if(shape==="diamond"){
    g.moveTo(0,-h); g.lineTo(h,0); g.lineTo(0,h); g.lineTo(-h,0); g.closePath();
  }else if(shape==="hexagon"){
    for(let i=0;i<6;i++){ const a=Math.PI/6 + i*Math.PI/3;
      const x=Math.cos(a)*h, y=Math.sin(a)*h; i?g.lineTo(x,y):g.moveTo(x,y); }
    g.closePath();
  }else{ // star
    for(let i=0;i<10;i++){
      const a = -Math.PI/2 + i*Math.PI/5, rr = i%2? h*0.44 : h;
      const x=Math.cos(a)*rr, y=Math.sin(a)*rr; i?g.lineTo(x,y):g.moveTo(x,y);
    }
    g.closePath();
  }
  g.fill(); g.stroke();
  g.restore();
}

function draw(){
  requestAnimationFrame(draw);
  if(!B) return;

  const now = performance.now();
  // 背景网格
  ctx.clearRect(0,0,CW,CH);
  ctx.save();
  ctx.strokeStyle = "rgba(0,240,255,.07)"; ctx.lineWidth = 1;
  for(let c=1;c<COLS;c++){ ctx.beginPath(); ctx.moveTo(c*CELL,0); ctx.lineTo(c*CELL,CH); ctx.stroke(); }
  for(let r=1;r<ROWS;r++){ ctx.beginPath(); ctx.moveTo(0,r*CELL); ctx.lineTo(CW,r*CELL); ctx.stroke(); }
  // 扫描线
  const sy = (now/14) % CH;
  const g2 = ctx.createLinearGradient(0, sy-40, 0, sy+40);
  g2.addColorStop(0,"rgba(0,240,255,0)"); g2.addColorStop(.5,"rgba(0,240,255,.09)"); g2.addColorStop(1,"rgba(0,240,255,0)");
  ctx.fillStyle = g2; ctx.fillRect(0, sy-40, CW, 80);
  ctx.restore();

  // hover 组高亮
  let hoverSet = null;
  if(hover && !B.over){
    const g = findGroup(hover.r, hover.c);
    if(g.length>=3) hoverSet = new Set(g.map(p=>p.r*100+p.c));
  }

  // 块
  for(let r=0;r<ROWS;r++){
    for(let c=0;c<COLS;c++){
      const cell = B.grid[r][c];
      if(!cell) continue;
      // 缓动下落
      cell.py += (cell.r - cell.py) * 0.22;
      if(Math.abs(cell.r - cell.py) < 0.002) cell.py = cell.r;
      const x = c*CELL + CELL/2;
      const y = cell.py*CELL + CELL/2;
      const isHover = hoverSet && hoverSet.has(r*100+c);
      const popT = clamp((now - cell.born)/260, 0, 1);
      const scale = 0.55 + 0.45*(1-Math.pow(1-popT,3));
      const pulse = cell.kind==="core" ? 1 + Math.sin(now/220)*0.06 : 1;

      ctx.save();
      ctx.translate(x, y);
      ctx.scale(scale*pulse, scale*pulse);

      if(cell.kind==="virus"){
        // 病毒：暗色块 + 红 X + 抖动
        const jx = Math.sin(now/60 + cell.uid)*1.2;
        ctx.translate(jx, 0);
        ctx.shadowColor = "#ff3b3b"; ctx.shadowBlur = 16;
        ctx.fillStyle = "rgba(40,8,16,.92)";
        ctx.strokeStyle = "#ff3b3b"; ctx.lineWidth = 2.2;
        ctx.beginPath(); ctx.rect(-CELL*0.34,-CELL*0.34,CELL*0.68,CELL*0.68); ctx.fill(); ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(-10,-10); ctx.lineTo(10,10); ctx.moveTo(10,-10); ctx.lineTo(-10,10);
        ctx.stroke();
        if(cell.hp===1){
          ctx.strokeStyle="rgba(255,255,255,.6)"; ctx.lineWidth=1;
          ctx.beginPath(); ctx.moveTo(-16,-6); ctx.lineTo(0,4); ctx.lineTo(16,-10); ctx.stroke();
        }
        ctx.restore();
        continue;
      }

      const col = COLORS[cell.color];
      const glow = isHover ? 26 : 12;
      drawShape(ctx, col.shape, 0, 0, CELL*0.5, col.hex, glow, 1);

      // 加密块：外层护罩
      if(cell.kind==="enc"){
        ctx.shadowBlur = 0;
        if(cell.hp>1){
          ctx.strokeStyle = "rgba(255,255,255,.75)"; ctx.lineWidth = 1.6;
          ctx.setLineDash([4,3]);
          ctx.beginPath(); ctx.arc(0,0,CELL*0.36,0,Math.PI*2); ctx.stroke();
          ctx.setLineDash([]);
        }else{
          ctx.strokeStyle = "rgba(255,255,255,.35)"; ctx.lineWidth = 1.2;
          ctx.beginPath(); ctx.moveTo(-12,-14); ctx.lineTo(2,0); ctx.lineTo(-8,14); ctx.stroke();
        }
      }
      // 核心块：金环
      if(cell.kind==="core"){
        ctx.shadowColor="#ffd34d"; ctx.shadowBlur=18;
        ctx.strokeStyle="#ffd34d"; ctx.lineWidth=2;
        ctx.beginPath(); ctx.arc(0,0,CELL*0.40, now/500, now/500 + Math.PI*1.5); ctx.stroke();
        ctx.beginPath(); ctx.arc(0,0,CELL*0.40, now/500+Math.PI, now/500 + Math.PI*2.2); ctx.stroke();
      }
      if(isHover){
        ctx.shadowBlur=0;
        ctx.strokeStyle="rgba(255,255,255,.85)"; ctx.lineWidth=1.5;
        ctx.beginPath(); ctx.rect(-CELL*0.44,-CELL*0.44,CELL*0.88,CELL*0.88); ctx.stroke();
      }
      ctx.restore();
    }
  }

  // 粒子
  for(let i=B.particles.length-1;i>=0;i--){
    const p = B.particles[i];
    p.x += p.vx; p.y += p.vy; p.vy += 0.16; p.life -= 0.026;
    if(p.life<=0){ B.particles.splice(i,1); continue; }
    ctx.save();
    ctx.globalAlpha = clamp(p.life,0,1);
    ctx.shadowColor = p.color; ctx.shadowBlur = 10;
    ctx.fillStyle = p.color;
    ctx.fillRect(p.x-p.size/2, p.y-p.size/2, p.size, p.size);
    ctx.restore();
  }

  // 超频覆盖
  if(B.oc>0){
    ctx.save();
    ctx.globalAlpha = 0.10 + Math.sin(now/100)*0.04;
    ctx.fillStyle = "#ff2e97"; ctx.fillRect(0,0,CW,CH);
    ctx.restore();
  }
  // 危险线（顶部 2 行提示）
  if(!B.over){
    let danger = 0;
    for(let c=0;c<COLS;c++){
      let h=0; for(let r=0;r<ROWS;r++) if(B.grid[r][c]) h++;
      if(h >= ROWS-1) danger++;
    }
    if(danger>0){
      ctx.save();
      ctx.globalAlpha = 0.35 + Math.sin(now/140)*0.2;
      ctx.strokeStyle="#ff3b3b"; ctx.lineWidth=3;
      ctx.beginPath(); ctx.moveTo(0,3); ctx.lineTo(CW,3); ctx.stroke();
      ctx.restore();
    }
  }
}
requestAnimationFrame(draw);

/* ---------- 鼠标输入 ---------- */
function cellFromEvent(e){
  const rect = cv.getBoundingClientRect();
  const x = e.clientX - rect.left, y = e.clientY - rect.top;
  const c = Math.floor(x / CELL), r = Math.floor(y / CELL);
  if(r<0||r>=ROWS||c<0||c>=COLS) return null;
  return {r,c};
}
cv.addEventListener("mousemove", e=>{
  const p = cellFromEvent(e);
  hover = p;
  cv.style.cursor = (p && at(p.r,p.c)) ? "pointer" : "default";
});
cv.addEventListener("mouseleave", ()=>{ hover=null; });
cv.addEventListener("click", e=>{
  const p = cellFromEvent(e);
  if(p) onClickCell(p.r, p.c);
});
cv.addEventListener("contextmenu", e=>e.preventDefault());

/* =========================================================
   主循环（时间推进）
   ========================================================= */
let lastT = performance.now();
function loop(){
  requestAnimationFrame(loop);
  const now = performance.now();
  let dt = (now - lastT)/1000; lastT = now;
  if(dt > 0.25) dt = 0.25;
  if(!B || B.over) return;

  B.time += dt;

  // RAM 回复
  const regen = S.mods.ramRegen * (B.oc>0 ? 1.5 : 1);
  B.ram = clamp(B.ram + regen*dt, 0, S.maxRam);

  // 超频计时
  if(B.oc>0){ B.oc -= dt; if(B.oc<0) B.oc=0; }

  // 追踪度
  if(B.grace>0){ B.grace -= dt; }
  else if(B.traceFreeze>0){ B.traceFreeze -= dt; }
  else B.trace += B.traceSpeed * dt * (B.oc>0 ? 0.55 : 1);
  if(B.trace >= 100){
    B.trace = 0;
    if(S.shieldLeft>0 && Math.random()<0.5){
      S.shieldLeft--;
      floatText("护盾抵御 ICE 反制", CW/2, 150, "#00f0ff", 17);
    }else{
      S.hp--;
      flashRed();
      floatText("ICE 反制！ −1 完整度", CW/2, 150, "#ff3b3b", 19);
      logm("· ICE 反制，完整度 -1", "r");
      for(let i=0;i<2;i++) spreadVirus();
      if(S.hp<=0){ endBattle(false); return; }
    }
  }

  // 数据涌入
  B.genTimer += dt;
  const interval = Math.max(0.45, (B.node.gen + S.mods.genBonus) * (B.deep?0.82:1)) * (B.oc>0 ? 1.9 : 1);
  if(B.genTimer >= interval){
    B.genTimer = 0;
    generateWave(B.node.type==="boss" ? DIFF.genCount : (DIFF.genCount + (B.li>=2?1:0)));
    if(!B.over) updateBattleUI();
  }

  // 病毒扩散
  B.virusTimer += dt;
  const vInt = 7.5 - B.li*0.5;
  if(B.virusTimer >= Math.max(3, vInt)){
    B.virusTimer = 0;
    spreadVirus();
  }

  // Boss：定期加密底行
  if(B.node.type==="boss"){
    B.encTimer += dt;
    if(B.encTimer > 13){
      B.encTimer = 0;
      for(let c=0;c<COLS;c++){
        const cell = B.grid[ROWS-1][c];
        if(cell && cell.kind==="normal"){ B.grid[ROWS-1][c] = mk("enc", cell.color, ROWS-1, c); B.grid[ROWS-1][c].py = ROWS-1; }
      }
      floatText("防火墙加密了底层数据", CW/2, 190, "#b026ff", 15);
    }
  }

  // 定期刷新 UI 数值
  if(Math.floor(now/200) % 2 === 0) updateBattleUI();
}
requestAnimationFrame(loop);

/* =========================================================
   战斗结束
   ========================================================= */
function endBattle(win){
  if(B.over) return;
  B.over = true; B.won = win;
  S.ram = B.ram;

  let credits = 0;
  if(win){
    credits = Math.round((B.node.rew + (S.mods.leech||0)) * (B.deep?1.5:1));
    const timeBonus = Math.max(0, Math.round(400 - B.time*4));
    const hpBonus = S.hp * 120;
    const chainBonus = B.maxChainSeen * 60;
    B.score += timeBonus + hpBonus + chainBonus;
    S.credits += credits;
    addScore(B.score);
    logm(`✓ 攻破节点，获得 ◈ ${credits}`, "g");
    logm(`  得分 ${B.score}（时间+${timeBonus} 完整度+${hpBonus} 连锁+${chainBonus}）`, "y");
    if(B.node.type==="boss"){
      logm("★ 核心数据库已窃取 —— BREACH COMPLETE", "g");
    }
  }else{
    B.score = Math.round(B.score*0.5);
    addScore(B.score);
    logm("✗ 连接被强制切断", "r");
  }

  // 结算面板
  const bonusWin = B.node.type==="boss";
  setTimeout(()=>{
    if(win && !bonusWin){
      finishNode(B.li, B.ni);
    }else if(win && bonusWin){
      endRun(true);
    }else{
      endRun(false);
    }
  }, 700);
}

function endRun(win){
  const m = loadMeta();
  const gain = shardGain(win);
  m.shards += gain;
  m.runs += 1;
  saveMeta(m);
  S.shardGain = gain;
  const D = DIFF, di = D.id, total = D.layers;
  const best = loadBest(di);
  const rec = { score: S.score, layer: win?total:Math.min(S.layer+1,total), win: !!win };
  if(!best.score || S.score > best.score) saveBest(rec, di);
  else if(win && !best.win) saveBest({ score: Math.max(best.score, S.score), layer:total, win:true }, di);

  $("end-title").textContent = win ? "BREACH COMPLETE" : "CONNECTION LOST";
  $("end-title").style.color = win ? "var(--lime)" : "var(--red)";
  $("end-sub").innerHTML = win
    ? `<span style="color:${D.color}">${D.full}</span> 核心数据库已窃取，你消失在霓虹雨里。`
    : `你在 <span style="color:${D.color}">${D.full}</span> 第 ${Math.min(S.layer+1,total)} 层被 ICE 反制，痕迹已抹除。`;
  $("end-stats").innerHTML = `
    <div class="resultline"><span>目标公司</span><b style="color:${D.color}">${D.full} · ${D.grade}</b></div>
    <div class="resultline"><span>最终得分</span><b>${S.score.toLocaleString()} <span style="color:#5a6a85;font-size:12px">(原始 ${Math.round(S.rawScore).toLocaleString()} × ${D.scoreMul.toFixed(2)})</span></b></div>
    <div class="resultline"><span>抵达层数</span><b>L${win?total:Math.min(S.layer+1,total)} / ${total}</b></div>
    <div class="resultline"><span>攻破节点</span><b>${S.nodesDone}</b></div>
    <div class="resultline"><span>装配芯片</span><b>${S.chips.length} / ${S.chipSlots} 槽</b></div>
    <div class="resultline"><span>深层扫描</span><b>${S.deepCleared} 层</b></div>
    <div class="resultline"><span>◆ 获得数据碎片</span><b style="color:#d9b6ff">+${S.shardGain||0}</b></div>
    <div class="resultline"><span>剩余完整度</span><b>${Math.max(0,S.hp)} / ${S.maxHp}</b></div>
    <div class="resultline"><span>该目标历史最佳</span><b style="color:${D.color}">${Math.max(loadBest(di).score||0, S.score).toLocaleString()}</b></div>
    <div class="logbox">${S.log.map(l=>`<div class="${l.c}">${l.t}</div>`).join("")}</div>`;
  show("end");
}

