  boss:  { ico:"◈", nm:"核心防火墙", cls:"t-boss" }
};

function genMap(){
  const D = DIFF, total = D.layers, layers = [];
  for(let L=0; L<total; L++){
    const nodes = [];
    if(L===total-1){
      nodes.push(makeNode("boss", L));
    }else{
      const n = L===0 ? 2 : ri(2,3);
      const pool = L===0 ? ["battle","battle"] : [];
      for(let i=0;i<n;i++){
        let t;
        if(pool.length) t = pool.pop();
        else{
          const r = Math.random();
          if(L>=2 && i===0 && Math.random()<0.4) t = "shop";
          else if(r<0.12) t = "shop";
          else if(r<0.26) t = "elite";
          else if(r<0.40) t = "cache";
          else t = "battle";
        }
        nodes.push(makeNode(t, L));
      }
    }
    layers.push({ idx:L, nodes, chosen:-1 });
  }
  return layers;
}
function makeNode(type, L){
  const D = DIFF, total = D.layers;
  const isBoss = type==="boss";
  const isElite = type==="elite";
  const prog = L / Math.max(1, total-1);          // 层进度 0→1，用于层内递增
  return {
    type, layer:L, done:false,
    target: isBoss ? D.bossTarget
                   : Math.max(20, Math.round((40 + L*9) * D.targetMul * (isElite?1.40:1))),
    gen: isBoss ? Math.max(0.8, 1.45 + D.genAdd*0.5)
                : clamp(2.55 - prog*0.95 + D.genAdd - (isElite?0.32:0), 0.62, 4),
    virus: isBoss ? 0.10*D.virusMul
                  : (0.048 + prog*0.055 + (isElite?0.042:0)) * D.virusMul,
    core: isBoss ? 0.10 : 0.055*D.coreMul,
    rew: Math.round((isBoss ? 130 : (isElite ? 58+L*10 : 26+L*8)) * D.rewMul),
    shop: null
  };
}

