function buyUpgrade(u){
  const m = loadMeta();
  const lv = m.lv[u.id]||0;
  if(lv >= u.max) return;
  const price = u.cost(lv);
  if(m.shards < price) return;
  m.shards -= price;
  m.lv[u.id] = lv + 1;
  saveMeta(m);
  renderMarket();
}

