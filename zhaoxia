  if(ni < 0){ renderMap(); show("map"); return; }
  finishNode(li, ni);
};
$("btn-flee").onclick = ()=>{
  if(!B || B.over) return;
  B.over = true;
  S.ram = B.ram;
  addScore(Math.round(B.score*0.3));
  logm("· 主动撤退，保留 30% 得分", "y");
  S.map[B.li].nodes[B.ni].done = true;
  S.nodesDone++;
  S.layer = B.li + 1;
  renderMap(); show("map");
};
$("btn-again").onclick = ()=>{ newRun(DIFF.id); renderMap(); show("map"); };
$("btn-title").onclick = ()=>{ renderTitle(); show("title"); };
$("btn-diff-back").onclick = ()=>{ renderTitle(); show("title"); };
$("btn-market").onclick = ()=>{ renderMarket(); show("market"); };
(function(){ const e=$("btn-mkt-icon"); if(e) e.innerHTML = SHARD_ICON.replace('width="26" height="26"','width="18" height="18"'); })();
$("btn-mkt-back").onclick = ()=>{ renderTitle(); show("title"); };

window.addEventListener("keydown", e=>{
  if(!$("screen-battle").classList.contains("on")) {
    if(e.key==="Escape" && $("screen-help").classList.contains("on")) $("btn-help-close").click();
    return;
  }
  if(e.key>="1" && e.key<="6"){ useSkill(parseInt(e.key)-1); }
  else if(e.key==="Escape"){ $("btn-flee").click(); }
  else if(e.key==="h" || e.key==="H"){
    const gs = allGroups(3);
    if(gs.length){
      gs.sort((a,b)=>b.length-a.length);
      const p = gs[0][0];
      hover = {r:p.r, c:p.c};
      tip(`提示：L${p.r+1} / C${p.c+1} 有 ${gs[0].length} 个可编译`);
      setTimeout(()=>{ if(hover && hover.r===p.r && hover.c===p.c) hover=null; }, 1600);
    }else tip("没有可编译的组，等待新数据");
  }
});

