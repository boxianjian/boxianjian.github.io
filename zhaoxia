function drawLogo(t){
  const cv = $("logo-canvas");
  if(!cv) return;
  const g = cv.getContext("2d");
  const dpr = Math.min(2, window.devicePixelRatio||1);
  const W = 112, H = 112;
  if(cv.width !== W*dpr){ cv.width = W*dpr; cv.height = H*dpr; cv.style.width=W+"px"; cv.style.height=H+"px"; }
  g.setTransform(dpr,0,0,dpr,0,0);
  g.clearRect(0,0,W,H);
  const cx = W/2, cy = H/2;

  // 外六边形（缓慢摆动）
  g.save();
  g.translate(cx, cy);
  g.rotate(Math.sin(t/2600)*0.06);
  g.strokeStyle = "#00f0ff";
  g.shadowColor = "#00f0ff";
  g.shadowBlur = 20;
  g.lineWidth = 4.5;
  g.lineJoin = "round";
  const R = 48;
  g.beginPath();
  for(let i=0;i<6;i++){
    const a = Math.PI/6 + i*Math.PI/3;
    const px = Math.cos(a)*R, py = Math.sin(a)*R;
    i===0 ? g.moveTo(px,py) : g.lineTo(px,py);
  }
  g.closePath(); g.stroke();

  // 内六边形（反向摆动，虚线）
  g.shadowBlur = 8;
  g.lineWidth = 1.6;
  g.strokeStyle = "rgba(0,240,255,.42)";
  g.rotate(-Math.sin(t/1900)*0.16);
  const R2 = 36;
  g.setLineDash([5,4]);
  g.beginPath();
  for(let i=0;i<6;i++){
    const a = Math.PI/6 + i*Math.PI/3;
    const px = Math.cos(a)*R2, py = Math.sin(a)*R2;
    i===0 ? g.moveTo(px,py) : g.lineTo(px,py);
  }
  g.closePath(); g.stroke();
  g.setLineDash([]);
  g.restore();

  // 扫描线（裁在六边形内，上下循环）
  g.save();
  g.translate(cx, cy);
  g.beginPath();
  for(let i=0;i<6;i++){
    const a = Math.PI/6 + i*Math.PI/3;
    const px = Math.cos(a)*R, py = Math.sin(a)*R;
    i===0 ? g.moveTo(px,py) : g.lineTo(px,py);
  }
  g.closePath(); g.clip();
  const sy = ((t/22) % (R*2)) - R;
  const grd = g.createLinearGradient(0, sy-16, 0, sy+16);
  grd.addColorStop(0,"rgba(0,240,255,0)");
  grd.addColorStop(.5,"rgba(0,240,255,.20)");
  grd.addColorStop(1,"rgba(0,240,255,0)");
  g.fillStyle = grd;
  g.fillRect(-R, sy-16, R*2, 32);
  g.restore();

  // 中心 >_（光标闪烁）
  g.save();
  g.translate(cx, cy);
  g.shadowColor = "#ff2e97";
  g.shadowBlur = 16;
  g.fillStyle = "#ff2e97";
  g.font = "bold 32px ui-monospace, Consolas, monospace";
  g.textAlign = "center";
  g.textBaseline = "middle";
  const blink = (Math.floor(t/520) % 2) === 0;
  g.fillText(blink ? ">_" : "> ", 1, 2);
  g.restore();
}
