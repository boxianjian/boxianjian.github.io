    logm(`· 缓存仓库：提取 ◈ ${gain} 信用点`, "y");
    finishNode(li, ni, {silent:true});
  }else{
    startBattle(li, ni);
  }
}

function finishNode(li, ni, opt){
  const L = S.map[li];
  const n = L.nodes[ni];
  n.done = true;
  L.chosen = ni;
  S.nodesDone++;
  const left = L.nodes.filter(x=>!x.done).length;
  if(left === 0){
    S.layer = li + 1;
    // 层奖励：深入下一层前重启系统，回复 1 点完整度 + 信用点
    let healed = false;
    if(S.hp < S.maxHp){ S.hp++; healed = true; }
    const bonus = Math.round((16 + li*6) * DIFF.rewMul);
    S.credits += bonus;
    addScore(200 + li*80);
    logm("▲ L"+(li+1)+" "+DIFF.layerNames[li]+" 全部节点已攻破 —— 下一层解锁", "g");
    logm("  层奖励：◈ "+bonus+(healed?" · 系统重启 +1 完整度":" · 完整度已满"), "y");
    if(S.deepMode){
      S.deepCleared++;
      S.chipSlots += 1;
      addScore(400 + li*150);
      logm("★ 深层扫描达成：芯片槽 +1（当前 "+S.chipSlots+" 槽）", "g");
      toast("深层扫描达成 · 芯片槽 +1", "#b026ff");
    }
    S.deepMode = false; S.deepLocked = false;
    if(S.layer < S.map.length){
      toast("L"+(li+1)+" 完全攻破 → L"+(S.layer+1)+" 解锁"+(healed?" · +1 完整度":"")+" · ◈"+bonus);
    }
  }else{
    logm("· L"+(li+1)+" 还剩 "+left+" 个节点未攻破", "y");
    if(!(opt && opt.silent)) toast("该层还剩 "+left+" 个节点 —— 全部攻破才能深入", "#ffb800");
  }
  renderMap(); show("map");
}

