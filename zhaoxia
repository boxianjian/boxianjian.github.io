/* =========================================================
   商店
   ========================================================= */
function genShop(node){
  const items = [];
  const owned = new Set(S.chips);
  const avail = CHIPS.filter(c=>!owned.has(c.id));
  const chipCount = Math.min(3, avail.length);
  const pool = avail.slice().sort(()=>Math.random()-0.5).slice(0, chipCount);
  pool.forEach(c=>{
    items.push({ kind:"chip", chip:c, price: Math.round((40 + c.rare*30 + S.layer*6) * DIFF.priceMul), sold:false });
  });
  items.push({ kind:"repair", name:"系统修复", desc:"恢复 1 点完整度", price:Math.round(38*DIFF.priceMul), sold:false });
  items.push({ kind:"ramup", name:"内存扩容", desc:"RAM 上限 +25 并充满", price:Math.round(44*DIFF.priceMul), sold:false });
  items.push({ kind:"skillup", name:"技能重写", desc:"随机一个技能消耗 -7", price:Math.round(46*DIFF.priceMul), sold:false });
  return items;
}
function renderShop(node){
  $("shop-cr").textContent = S.credits;
  $("shop-hp").textContent = S.hp + " / " + S.maxHp;
  const slotTip = $("shop-slot");
  if(slotTip) slotTip.textContent = "芯片槽 " + S.chips.length + " / " + S.chipSlots;
  const box = $("shop-items");
  box.innerHTML = "";
  node.shop.forEach((it, i)=>{
    const el = document.createElement("div");
    const rare = it.kind==="chip" && it.chip.rare>0;
    const full = it.kind==="chip" && S.chips.length >= S.chipSlots;
    const cant = S.credits < it.price || full;
    el.className = "item" + (it.sold?" sold":"") + (rare?" rare":"") + (!it.sold && cant?" cant":"");
    const nm = it.kind==="chip" ? it.chip.name : it.name;
    const ds = it.kind==="chip" ? it.chip.desc : it.desc;
    el.innerHTML = `<div class="in">${it.kind==="chip"?"◈ ":"⌁ "}${nm}</div><div class="id">${ds}</div>
      <div class="ip">${it.sold?"已装配 / 已使用":(full?"芯片槽已满":"◈ "+it.price)}</div>`;
    if(!it.sold) el.onclick = ()=> buy(node, it, i);
    box.appendChild(el);
  });
}
function buy(node, it, i){
  if(S.credits < it.price || it.sold) return;
  S.credits -= it.price;
  it.sold = true;
  if(it.kind==="chip"){
    if(S.chips.length >= S.chipSlots){ S.credits += it.price; it.sold=false; toast("芯片槽已满（"+S.chipSlots+"）","#ff3b3b"); renderShop(node); return; }
    S.chips.push(it.chip.id);
    recalcMods();
    logm(`· 装配芯片【${it.chip.name}】`, "g");
  }else if(it.kind==="repair"){
    S.hp = Math.min(S.maxHp, S.hp+1);
    logm(`· 系统修复 +1`, "g");
  }else if(it.kind==="ramup"){
    S.maxRam += 25; S.ram = S.maxRam;
    logm(`· 内存扩容 +25`, "g");
  }else if(it.kind==="skillup"){
    const s = pick(S.skills.filter(x=>x.cur>10)) || pick(S.skills);
    s.cur = Math.max(10, s.cur - 7);
    logm(`· 技能重写：${s.name} 消耗降至 ${s.cur}`, "g");
  }
  renderShop(node);
}

/* =========================================================
   战斗初始化
   ========================================================= */
function startBattle(li, ni){
  const n = S.map[li].nodes[ni];
  B = {
    node:n, li, ni,
    grid: Array.from({length:ROWS}, ()=>Array(COLS).fill(null)),
    progress:0, target:n.target,
    score:0, chain:0,
    trace:0, grace: S.deepMode ? Math.round(DIFF.grace*0.7) : DIFF.grace,
    deep: !!S.deepMode,
    traceSpeed: (n.type==="boss" ? 1.9 : (1.5 + li*0.22 + (n.type==="elite"?0.6:0))) * DIFF.traceMul * (S.deepMode?1.35:1),
    ram:S.ram, genTimer:0, virusTimer:0,
    oc:0, cleared:0, clearedForCompress:0,
    over:false, won:false, shake:0,
    particles:[], hint:null, bossStage:0, encTimer:0, traceFreeze:0,
    time:0, maxChainSeen:0, clicks:0
  };
  // 初始填充 5 行
  for(let r=ROWS-5;r<ROWS;r++) for(let c=0;c<COLS;c++) B.grid[r][c] = newCell(r,c,n);
  S.shieldLeft = S.mods.shield;
  renderBattleStatic();
  show("battle");
  $("b-obj").innerHTML = n.type==="boss"
    ? `目标：攻破 <b>核心防火墙</b> — 编译 ${n.target} 个数据包`
    : `目标：编译 <b>${n.target}</b> 个数据包`;
  logm(`· 进入 L${li+1} ${NODE_TYPES[n.type].nm}`, "c");
  updateBattleUI();
}

function newCell(r,c,n){
  const roll = Math.random();
  if(roll < n.virus){ return mk("virus", -1, r, c); }
  if(roll < n.virus + (n.core * (S.mods.coreRate||1))){ return mk("core", ri(0,5), r, c); }
  if(roll < n.virus + 0.20){ return mk("enc", ri(0,5), r, c); }
  return mk("normal", ri(0,5), r, c);
}
let UID = 1;
function mk(kind, colorIdx, r, c){
  return {
    uid: UID++, kind, color: colorIdx,
    hp: kind==="virus" ? 2 : (kind==="enc" ? 2 : 1),
    r, c, py: r, born: performance.now(), pop:0
  };
}

/* =========================================================
   战斗：网格操作
   ========================================================= */
function at(r,c){ return (r>=0&&r<ROWS&&c>=0&&c<COLS) ? B.grid[r][c] : null; }

/* 可参与连通匹配的块：normal / core / enc（按颜色），virus 不算 */
function matchable(cell){
  return cell && (cell.kind==="normal" || cell.kind==="core" || cell.kind==="enc");
}
function findGroup(r,c){
  const start = at(r,c);
  if(!matchable(start)) return [];
  const col = start.color, seen = new Set(), stack = [[r,c]], out = [];
  seen.add(r*100+c);
  while(stack.length){
    const [y,x] = stack.pop();
    out.push({r:y,c:x});
    [[1,0],[-1,0],[0,1],[0,-1]].forEach(([dy,dx])=>{
      const ny=y+dy, nx=x+dx, k=ny*100+nx;
      if(seen.has(k)) return;
      const cc = at(ny,nx);
      if(matchable(cc) && cc.color===col && cc.kind!=="coreBroken"){
        seen.add(k); stack.push([ny,nx]);
      }
    });
  }
  return out;
}

/* 找出所有连通组（用于自动连锁与提示） */
function allGroups(minSize){
  const seen = new Set(), groups = [];
  for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++){
    const k = r*100+c;
    if(seen.has(k)) continue;
    const cell = at(r,c);
    if(!matchable(cell)) continue;
    const g = findGroup(r,c);
    g.forEach(p=>seen.add(p.r*100+p.c));
    if(g.length >= minSize) groups.push(g);
  }
  return groups;
}

/* 重力：每列压实到底部 */
function compact(){
  for(let c=0;c<COLS;c++){
    let write = ROWS-1;
    for(let r=ROWS-1;r>=0;r--){
      const cell = B.grid[r][c];
      if(cell){
        if(write !== r){
          B.grid[write][c] = cell;
          B.grid[r][c] = null;
          cell.r = write;
        }
        write--;
      }
    }
  }
}

/* 消除一组，返回消除数量与得分 */
function clearGroup(group, chain){
  const mult = 1 + (chain-1) * (0.5 + S.mods.chainGrow - 0.5);
  const ocMul = B.oc>0 ? (2 * (1 + S.mods.ocBoost*0.5)) : 1;
  let gained = 0, progAdd = 0;
  const removed = [];

  group.forEach(({r,c})=>{
    const cell = at(r,c);
    if(!cell) return;
    removed.push(cell);
    B.grid[r][c] = null;
    gained += S.mods.scorePer;
    progAdd += 1;
    if(cell.kind==="core"){
      progAdd += 8 + S.mods.coreBonus;
      gained += 40;
      spawnBurst(c, r, "#ffd34d", 22);
    }else{
      spawnBurst(c, r, COLORS[cell.color].hex, 12);
    }
  });
  // 加密块：hp-1 时放回（不消失）
  removed.forEach(cell=>{
    if(cell.kind==="enc" && cell.hp>1){
      cell.hp = 1;
      if(B.grid[cell.r][cell.c]===null){ B.grid[cell.r][cell.c]=cell; }
      else{
        for(let rr=ROWS-1;rr>=0;rr--){ if(!B.grid[rr][cell.c]){ B.grid[rr][cell.c]=cell; cell.r=rr; break; } }
      }
      progAdd -= 1; gained -= S.mods.scorePer;
    }
  });

  // 相邻病毒受伤
  const vset = new Set();
  group.forEach(({r,c})=>{
    [[1,0],[-1,0],[0,1],[0,-1]].forEach(([dy,dx])=>{
      const cc = at(r+dy, c+dx);
      if(cc && cc.kind==="virus") vset.add(cc.uid);
    });
  });
  vset.forEach(uid=>{
    for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++){
      const cc = B.grid[r][c];
      if(cc && cc.uid===uid){
        cc.hp--;
        cc.pop = performance.now();
        if(cc.hp<=0){
          B.grid[r][c] = null;
          spawnBurst(c, r, "#ff3b3b", 14);
          progAdd += 2; gained += 15;
        }
      }
    }
  });

  const real = removed.filter(x=>!(x.kind==="enc" && x.hp===1)).length;
  let pts = Math.round(gained * mult * ocMul);
  if(group.length>=5) pts += S.mods.bigBonus;
  B.score += pts;
  B.progress += progAdd;
  B.cleared += progAdd;
  B.clearedForCompress += real;
  B.trace = clamp(B.trace - group.length*1.6, 0, 100);
  B.maxChainSeen = Math.max(B.maxChainSeen, chain);

  if(chain>=2){
    floatText(`CHAIN ×${chain}  +${pts}`, CW/2, 90, "#ffb800", 20);
  }else if(pts>0){
    floatText(`+${pts}`, CW/2, 120, "#00f0ff", 15);
  }
  return { pts, progAdd };
}

/* ---------- 点击处理 ---------- */
function onClickCell(r,c){
  if(!B || B.over) return;
  const g = findGroup(r,c);
  if(g.length < 3){
    const cell = at(r,c);
    if(cell && cell.kind==="virus") tip("病毒无法直接编译 —— 消除它相邻的数据包");
    else if(cell && cell.kind==="enc") tip("加密块需要与其同色的其他数据包一起编译");
    else tip("至少需要 3 个相邻同色数据包");
    return;
  }
  B.clicks++;
  B.chain = 1;
  clearGroup(g, 1);
  compact();
  resolveChains();
  afterAction();
}

/* 自动连锁：塌落后自动形成 >=4 的组 */
function resolveChains(){
  let guard = 0;
  while(guard++ < 12){
    const groups = allGroups(4);
    if(!groups.length) break;
    // 依次消除（全部同轮，chain 递增）
    groups.forEach((g, i)=>{
      B.chain = B.chain + 1;
      clearGroup(g, B.chain);
    });
    compact();
  }
  if(B.chain>1) setTimeout(()=>{ B.chain = 0; }, 700);
}

/* ---------- 数据涌入 ---------- */
function generateWave(count){
  // 选非满的列
  let overflowed = false;
  for(let i=0;i<count;i++){
    const heights = [];
    for(let c=0;c<COLS;c++){
      let h=0; for(let r=0;r<ROWS;r++) if(B.grid[r][c]) h++;
      heights.push(h);
    }
    const free = heights.map((h,c)=>({h,c})).filter(x=>x.h < ROWS);
    if(!free.length){
      overflow(); overflowed = true; continue;
    }
    free.sort((a,b)=>a.h-b.h);
    const target = free[Math.min(free.length-1, ri(0, Math.min(2, free.length-1)))];
    const c = target.c;
    // 找该列最上方的空格
    let r = 0; while(r<ROWS && B.grid[r][c]) r++;
    if(r>=ROWS){ overflow(); continue; }
    const cell = newCell(r, c, B.node);
    cell.py = -1.2;
    B.grid[r][c] = cell;
  }
  if(!overflowed) return;
}

function overflow(){
  if(S.shieldLeft > 0){
    S.shieldLeft--;
    floatText("溢出护盾抵消！", CW/2, 160, "#00f0ff", 17);
    logm("· 溢出护盾抵消一次溢出", "g");
    // 强制清理顶部
    for(let c=0;c<COLS;c++) for(let r=0;r<3;r++) if(B.grid[r][c]){ B.grid[r][c]=null; }
    compact();
    return;
  }
  S.hp--;
  B.shake = 1;
  flashRed();
  floatText("数据溢出  −1 完整度", CW/2, 160, "#ff3b3b", 18);
  logm("· 数据溢出，完整度 -1", "r");
  // 清理顶部 2 行缓解
  for(let c=0;c<COLS;c++) for(let r=0;r<2;r++) if(B.grid[r][c]) spawnBurst(c, r, "#ff3b3b", 6), B.grid[r][c]=null;
  compact();
  updateBattleUI();
  if(S.hp<=0) endBattle(false);
}

/* ---------- 病毒扩散 ---------- */
function spreadVirus(){
  const cands = [];
  for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++){
    const cell = B.grid[r][c];
    if(!cell) continue;
    if(cell.kind==="virus"){
      [[1,0],[-1,0],[0,1],[0,-1]].forEach(([dy,dx])=>{
        const t = at(r+dy,c+dx);
        if(t && t.kind==="normal") cands.push({r:r+dy,c:c+dx});
      });
    }
  }
  if(!cands.length) return;
  const p = pick(cands);
  const cell = B.grid[p.r][p.c];
  if(cell){ B.grid[p.r][p.c] = mk("virus", -1, p.r, p.c); B.grid[p.r][p.c].py = p.r; }
}

/* ---------- 行动后检查 ---------- */
function afterAction(){
  // 压缩芯片
  if(S.mods.compress>0 && B.clearedForCompress >= S.mods.compress){
    B.clearedForCompress -= S.mods.compress;
    purgeRows(1, false);
    floatText("数据压缩：清理底部一行", CW/2, 200, "#b026ff", 15);
  }
  updateBattleUI();
  if(B.progress >= B.target && !B.over){
    if(B.node.type==="boss" && B.bossStage < DIFF.bossStages-1){
      B.bossStage++;
      floatText(`防火墙第 ${B.bossStage} 层崩解！`, CW/2, 130, "#ff3b3b", 22);
      logm(`· 核心防火墙第 ${B.bossStage} 层崩解`, "y");
      B.trace = 0;
      // 病毒浪潮
      for(let i=0;i<5;i++) spreadVirus();
      B.target = Math.round(B.target * 1.25);
      B.traceSpeed *= 1.2;
    }else{
      endBattle(true);
    }
  }
}

/* =========================================================
   技能
   ========================================================= */
function useSkill(i){
  if(!B || B.over) return;
  const s = S.skills[i];
  if(!s || B.ram < s.cur) return;
  B.ram -= s.cur;
  const lv = s.lv || 0;
  const extra = S.mods.purgeBoost + (s.id==="purge" ? lv : 0);

  if(s.id==="ping"){
    let n = 0;
    for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++){
      const cell = B.grid[r][c];
      if(cell && cell.kind==="virus"){
        B.grid[r][c] = mk("normal", ri(0,5), r, c);
        B.grid[r][c].py = r;
        spawnBurst(c, r, "#00f0ff", 10);
        n++;
      }
    }
    if(lv) B.ram = clamp(B.ram + lv*5, 0, S.maxRam);
    floatText(`PING：净化 ${n} 个病毒`, CW/2, 150, "#00f0ff", 17);
    logm(`· PING 净化 ${n} 个病毒`, "g");
  }
  else if(s.id==="oc"){
    B.oc = 8 + lv*2 + S.mods.ocBoost*4;
    floatText("OVERCLOCK 启动！", CW/2, 150, "#ff2e97", 19);
    logm("· OVERCLOCK 启动", "g");
  }
  else if(s.id==="purge"){
    purgeRows(2 + extra, true);
    if(extra) B.ram = clamp(B.ram + 15, 0, S.maxRam);
    floatText("PURGE：清理底层", CW/2, 150, "#39ff14", 17);
    logm("· PURGE 清理底层", "g");
  }
  else if(s.id==="rollb"){
    let n = 0;
    for(let c=0;c<COLS;c++) for(let r=0;r<2+lv+extra;r++){
      if(B.grid[r][c]){ spawnBurst(c, r, "#ffb800", 8); B.grid[r][c]=null; n++; }
    }
    compact();
    B.progress += Math.round(n*0.4);
    floatText(`ROLLBACK：清除 ${n} 个`, CW/2, 150, "#ffb800", 17);
    logm(`· ROLLBACK 清除 ${n} 个数据包`, "g");
  }
  else if(s.id==="ghost"){
    B.traceFreeze = 6 + lv*2;
    floatText("GHOST：追踪冻结 "+(6+lv*2)+"s", CW/2, 150, "#b026ff", 18);
    logm("· GHOST 追踪冻结", "g");
  }
  else if(s.id==="cascade"){
    // 统计底部各行颜色，选出现最多的颜色，把底部 N 行同化
    const rows = 1 + lv;
    const cnt = [0,0,0,0,0,0];
    for(let c=0;c<COLS;c++) for(let k=0;k<rows;k++){
      const cell = B.grid[ROWS-1-k][c];
      if(cell && cell.kind!=="virus" && cell.color>=0) cnt[cell.color]++;
    }
    let best = 0;
    for(let i=1;i<cnt.length;i++) if(cnt[i]>cnt[best]) best = i;
    for(let c=0;c<COLS;c++) for(let k=0;k<rows;k++){
      const r = ROWS-1-k, cell = B.grid[r][c];
      if(cell && cell.kind!=="virus"){
        cell.color = best;
        cell.kind = "normal";
        cell.hp = 1;
        spawnBurst(c, r, COLORS[best].hex, 8);
      }
    }
    floatText("CASCADE：底部 "+rows+" 行同化", CW/2, 150, "#39ff14", 18);
    logm("· CASCADE 同化底部 "+rows+" 行", "g");
  }
  updateBattleUI();
  afterAction();
}

function purgeRows(n, countProgress){
  let cnt = 0;
  for(let c=0;c<COLS;c++){
    for(let k=0;k<n;k++){
      const r = ROWS-1-k;
      const cell = B.grid[r][c];
      if(cell){
        if(cell.kind==="virus"){ B.grid[r][c]=null; cnt++; continue; }
        if(cell.kind==="enc" && cell.hp>1){ cell.hp=1; continue; }
        B.grid[r][c] = null; cnt++;
      }
    }
  }
  compact();
  if(countProgress){ B.progress += cnt; B.cleared += cnt; B.score += cnt*S.mods.scorePer; }
}

/* =========================================================
