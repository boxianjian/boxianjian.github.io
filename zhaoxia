<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NEON://BREACH — 霓虹入侵</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%2305070f'/%3E%3Cpolygon points='32,6 55,19.5 55,44.5 32,58 9,44.5 9,19.5' fill='none' stroke='%2300f0ff' stroke-width='4' stroke-linejoin='round'/%3E%3Cpolygon points='32,14 47,23 47,41 32,50 17,41 17,23' fill='none' stroke='%2300f0ff' stroke-width='1.5' opacity='.45'/%3E%3Ctext x='32' y='39' font-family='monospace' font-weight='bold' font-size='20' fill='%23ff2e97' text-anchor='middle'%3E%26gt;_%3C/text%3E%3C/svg%3E">
<link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%2305070f'/%3E%3Cpolygon points='32,6 55,19.5 55,44.5 32,58 9,44.5 9,19.5' fill='none' stroke='%2300f0ff' stroke-width='4' stroke-linejoin='round'/%3E%3Ctext x='32' y='39' font-family='monospace' font-weight='bold' font-size='20' fill='%23ff2e97' text-anchor='middle'%3E%26gt;_%3C/text%3E%3C/svg%3E">
<style>
:root{
  --bg:#05070f;
  --bg2:#0a0e1a;
  --cyan:#00f0ff;
  --magenta:#ff2e97;
  --lime:#39ff14;
  --amber:#ffb800;
  --violet:#b026ff;
  --red:#ff3b3b;
  --dim:#5a6a85;
  --panel:rgba(10,16,30,.82);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  background:
    radial-gradient(1200px 700px at 20% -10%, rgba(0,240,255,.10), transparent 60%),
    radial-gradient(900px 600px at 100% 110%, rgba(255,46,151,.12), transparent 60%),
    var(--bg);
  color:#dbe7ff;
  font-family:"Share Tech Mono",ui-monospace,"SFMono-Regular",Consolas,"Microsoft YaHei",monospace;
  overflow:hidden;
  user-select:none;
  -webkit-font-smoothing:antialiased;
}
body::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:999;
  background:repeating-linear-gradient(0deg,rgba(255,255,255,.028) 0 1px,transparent 1px 3px);
  mix-blend-mode:overlay;
}
#app{position:relative;width:100vw;height:100vh;overflow:hidden}
.screen{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center}
.screen.on{display:flex}
.anim{animation:fadein .35s ease both}
@keyframes fadein{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

/* ---------- 通用组件 ---------- */
.neon{ text-shadow:0 0 8px currentColor,0 0 22px currentColor; }
.btn{
  position:relative;display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:11px 22px;border:1px solid var(--cyan);background:rgba(0,240,255,.06);
  color:var(--cyan);font:inherit;font-size:15px;letter-spacing:2px;cursor:pointer;
  clip-path:polygon(10px 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%,0 10px);
  transition:.16s;
}
.btn:hover{background:rgba(0,240,255,.18);box-shadow:0 0 18px rgba(0,240,255,.45);transform:translateY(-1px)}
.btn:active{transform:translateY(1px)}
.btn.mag{border-color:var(--magenta);color:var(--magenta);background:rgba(255,46,151,.06)}
.btn.mag:hover{background:rgba(255,46,151,.18);box-shadow:0 0 18px rgba(255,46,151,.45)}
.btn.amb{border-color:var(--amber);color:var(--amber);background:rgba(255,184,0,.07)}
.btn.amb:hover{background:rgba(255,184,0,.18);box-shadow:0 0 18px rgba(255,184,0,.4)}
.btn.lime{border-color:var(--lime);color:var(--lime);background:rgba(57,255,20,.06)}
.btn.lime:hover{background:rgba(57,255,20,.18);box-shadow:0 0 18px rgba(57,255,20,.4)}
.btn.ghost{border-color:#2c3a55;color:#7f90ad;background:transparent}
.btn.ghost:hover{border-color:#5a6a85;color:#cfe0ff;box-shadow:none;background:rgba(255,255,255,.04)}
.btn.sm{padding:7px 12px;font-size:12px;letter-spacing:1px}
.btn:disabled{opacity:.32;cursor:not-allowed;transform:none;box-shadow:none}

.tag{font-size:11px;letter-spacing:2px;color:var(--dim);text-transform:uppercase}
.hint{font-size:12px;color:#6e809e;letter-spacing:1px;line-height:1.7}
.hint b{color:var(--cyan);font-weight:400}

/* ---------- 标题页 ---------- */
#screen-title{justify-content:center;gap:0}
.title-wrap{display:flex;flex-direction:column;align-items:center;gap:26px;padding:20px}
.logo{font-size:clamp(44px,8vw,96px);letter-spacing:6px;line-height:1;color:var(--cyan);font-weight:700}
.logo .sl{color:var(--dim);font-size:.42em;letter-spacing:3px}
.logo .mg{color:var(--magenta)}
.subtitle{font-size:clamp(14px,2vw,20px);letter-spacing:9px;color:var(--magenta)}
.title-desc{max-width:640px;text-align:center;font-size:13px;line-height:2;color:#8fa3c4;letter-spacing:1px}
.title-desc em{color:var(--lime);font-style:normal}
.title-btns{display:flex;gap:16px;flex-wrap:wrap;justify-content:center;margin-top:6px}
.scanline{position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--cyan),transparent);
  opacity:.5;animation:scan 6s linear infinite}
@keyframes scan{0%{top:-2%}100%{top:102%}}
.corner{position:absolute;width:26px;height:26px;border:2px solid rgba(0,240,255,.35)}
.corner.tl{top:18px;left:18px;border-right:0;border-bottom:0}
.corner.tr{top:18px;right:18px;border-left:0;border-bottom:0}
.corner.bl{bottom:18px;left:18px;border-right:0;border-top:0}
.corner.br{bottom:18px;right:18px;border-left:0;border-top:0}

/* ---------- 地图页 ---------- */
#screen-map{justify-content:flex-start;padding:26px 16px 16px;gap:14px}
.topbar{
  width:min(1080px,96vw);display:flex;align-items:center;justify-content:space-between;gap:14px;
  padding:12px 18px;background:var(--panel);border:1px solid rgba(0,240,255,.18);
  clip-path:polygon(12px 0,100% 0,100% calc(100% - 12px),calc(100% - 12px) 100%,0 100%,0 12px);
}
.stats{display:flex;gap:20px;align-items:center;flex-wrap:wrap;font-size:13px;letter-spacing:1px}
.stat{display:flex;align-items:center;gap:7px}
.stat .k{color:var(--dim);font-size:11px}
.stat .v{font-size:16px}
.hp-pips{display:flex;gap:5px}
.pip{width:11px;height:14px;background:#1b2436;border:1px solid #34435f;transform:skewX(-12deg)}
.pip.on{background:var(--red);border-color:#ff8080;box-shadow:0 0 10px rgba(255,59,59,.8)}
.pip.shield{background:var(--cyan);border-color:#9ff; box-shadow:0 0 10px rgba(0,240,255,.8)}

.mapbox{
  width:min(1080px,96vw);flex:1;position:relative;overflow:auto;
  background:linear-gradient(180deg,rgba(8,12,24,.6),rgba(5,7,15,.2));
  border:1px solid rgba(0,240,255,.12);padding:18px;
}
.layers{display:flex;flex-direction:column-reverse;gap:0;min-width:760px}
.layer{display:flex;align-items:center;gap:14px;padding:10px 0;position:relative}
.layer-hd{width:120px;flex:none;font-size:11px;letter-spacing:2px;color:var(--dim)}
.layer-hd .ln{font-size:19px;color:#9fb3d4;letter-spacing:1px}
.layer-nodes{display:flex;gap:22px;flex:1;flex-wrap:wrap}
.node{
  width:132px;padding:12px 10px;background:rgba(12,18,32,.9);border:1px solid #263349;
  cursor:pointer;transition:.16s;position:relative;
  clip-path:polygon(9px 0,100% 0,100% calc(100% - 9px),calc(100% - 9px) 100%,0 100%,0 9px);
}
.node:hover{transform:translateY(-3px)}
.node.sel{border-color:var(--lime);box-shadow:0 0 20px rgba(57,255,20,.3)}
.node.locked{opacity:.38;cursor:not-allowed;filter:grayscale(.7)}
.node.done{opacity:.5;cursor:default;border-color:#243044}
.node .ico{font-size:22px;line-height:1;margin-bottom:6px}
.node .nm{font-size:13px;letter-spacing:1px;margin-bottom:4px}
.node .ds{font-size:10px;color:#7b8db0;line-height:1.5;letter-spacing:.5px}
.node .rw{font-size:10px;color:var(--amber);margin-top:5px}
.t-battle .ico{color:var(--cyan)} .t-battle .nm{color:var(--cyan)}
.t-elite .ico{color:var(--magenta)} .t-elite .nm{color:var(--magenta)}
.t-elite{border-color:rgba(255,46,151,.4)}
.t-shop .ico{color:var(--amber)} .t-shop .nm{color:var(--amber)}
.t-shop{border-color:rgba(255,184,0,.35)}
.t-cache .ico{color:var(--lime)} .t-cache .nm{color:var(--lime)}
.t-boss .ico{color:var(--red)} .t-boss .nm{color:var(--red)}
.t-boss{border-color:rgba(255,59,59,.5);width:170px;box-shadow:0 0 16px rgba(255,59,59,.16)}
.mapfoot{width:min(1080px,96vw);display:flex;justify-content:space-between;align-items:center;gap:12px}
.chipline{display:flex;gap:8px;flex-wrap:wrap;align-items:center;font-size:11px}
.chip{
  padding:5px 10px;border:1px solid var(--violet);color:#d9b6ff;background:rgba(176,38,255,.1);
  font-size:11px;letter-spacing:1px;cursor:help;
  clip-path:polygon(6px 0,100% 0,100% calc(100% - 6px),calc(100% - 6px) 100%,0 100%,0 6px);
}
.chip i{font-style:normal;color:var(--violet);margin-right:4px}

/* ---------- 战斗页 ---------- */
#screen-battle{flex-direction:row;align-items:stretch;justify-content:center;padding:0;gap:0}
.bcol{display:flex;flex-direction:column;padding:16px 18px;gap:12px;width:270px;flex:none;
  background:linear-gradient(180deg,rgba(8,12,24,.9),rgba(5,7,15,.95));}
.bcol.left{border-right:1px solid rgba(0,240,255,.14)}
.bcol.right{border-left:1px solid rgba(0,240,255,.14)}
.bcenter{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;position:relative;min-width:0}
.panel{border:1px solid rgba(0,240,255,.16);background:rgba(10,16,30,.6);padding:12px 13px;
  clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px),calc(100% - 8px) 100%,0 100%,0 8px);}
.ptitle{font-size:10px;letter-spacing:3px;color:var(--dim);margin-bottom:9px}
.bar{height:14px;background:#111a2c;border:1px solid #26334a;position:relative;overflow:hidden}
.bar > i{display:block;height:100%;width:0%;transition:width .22s ease;position:relative}
.bar > i::after{content:"";position:absolute;inset:0;
  background:repeating-linear-gradient(115deg,rgba(255,255,255,.22) 0 6px,transparent 6px 12px)}
.bar.ram > i{background:linear-gradient(90deg,#0af,#7df);box-shadow:0 0 12px rgba(0,170,255,.7)}
.bar.dl > i{background:linear-gradient(90deg,#0f6,#39ff14);box-shadow:0 0 12px rgba(57,255,20,.6)}
.bar.tr > i{background:linear-gradient(90deg,#f0a,#ff2e97);box-shadow:0 0 12px rgba(255,46,151,.6)}
.barlabel{display:flex;justify-content:space-between;font-size:11px;margin-bottom:5px;letter-spacing:1px}
.bigscore{font-size:36px;color:var(--cyan);letter-spacing:2px;line-height:1}
.chaintxt{font-size:14px;color:var(--amber);height:20px;letter-spacing:2px}
.skill{width:100%;text-align:left;padding:10px 12px;border:1px solid #2a3a55;background:rgba(14,20,36,.8);
  cursor:pointer;transition:.15s;position:relative;overflow:hidden;font:inherit}
.skill:hover:not(:disabled){border-color:var(--cyan);background:rgba(0,240,255,.1)}
.skill:disabled{opacity:.4;cursor:not-allowed}
.skill .sn{font-size:13px;letter-spacing:1px;color:#cfe4ff;display:flex;justify-content:space-between;align-items:center}
.skill .sc{font-size:11px;color:var(--cyan)}
.skill .sd{font-size:10px;color:#7089a8;margin-top:4px;line-height:1.5}
.skill .cd{position:absolute;left:0;bottom:0;height:2px;background:var(--cyan);width:0%}
.skill.active{border-color:var(--lime);box-shadow:0 0 14px rgba(57,255,20,.35)}
#gridwrap{position:relative}
#grid{display:block;cursor:pointer;border:1px solid rgba(0,240,255,.22);background:rgba(3,6,14,.75);
  box-shadow:0 0 40px rgba(0,240,255,.08) inset,0 0 30px rgba(0,0,0,.6)}
.bcenter .obj{font-size:12px;letter-spacing:2px;color:#8fa3c4;text-align:center}
.bcenter .obj b{color:var(--lime)}
.floaters{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.floater{position:absolute;font-size:18px;color:var(--amber);letter-spacing:1px;text-shadow:0 0 10px currentColor;
  animation:floatup 1s ease-out forwards}
@keyframes floatup{0%{opacity:0;transform:translateY(6px) scale(.8)}18%{opacity:1;transform:translateY(-4px) scale(1.08)}
  100%{opacity:0;transform:translateY(-46px) scale(1)}}
.shake{animation:shk .3s}
@keyframes shk{0%,100%{transform:none}25%{transform:translate(-5px,3px)}50%{transform:translate(4px,-3px)}75%{transform:translate(-3px,-2px)}}
.flashred{position:absolute;inset:0;background:rgba(255,40,40,.28);pointer-events:none;opacity:0}
.flashred.on{animation:fr .4s}
@keyframes fr{0%{opacity:1}100%{opacity:0}}

/* ---------- 商店 / 结算 ---------- */
.wrap{width:min(940px,94vw);max-height:92vh;overflow:auto;padding:26px 26px 30px;
  background:var(--panel);border:1px solid rgba(255,184,0,.28);position:relative;
  clip-path:polygon(16px 0,100% 0,100% calc(100% - 16px),calc(100% - 16px) 100%,0 100%,0 16px);}
.h2{font-size:22px;letter-spacing:5px;color:var(--amber);margin-bottom:4px}
.shopgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px;margin:20px 0}
.item{border:1px solid #2b3a55;background:rgba(12,18,32,.85);padding:14px;cursor:pointer;transition:.16s;
  display:flex;flex-direction:column;gap:7px;
  clip-path:polygon(9px 0,100% 0,100% calc(100% - 9px),calc(100% - 9px) 100%,0 100%,0 9px);}
.item:hover:not(.sold):not(.cant){border-color:var(--amber);transform:translateY(-3px);box-shadow:0 0 20px rgba(255,184,0,.22)}
.item.sold{opacity:.35;cursor:default}
.item.cant{opacity:.5;cursor:not-allowed}
.item .in{font-size:15px;letter-spacing:1px;color:#e6f0ff}
.item .id{font-size:11px;color:#7b8db0;line-height:1.6}
.item .ip{font-size:14px;color:var(--amber);margin-top:auto;letter-spacing:1px}
.item.rare{border-color:rgba(176,38,255,.5)} .item.rare .in{color:#e0b8ff}
.rowend{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-top:8px}
.resultline{font-size:14px;letter-spacing:2px;color:#9fb3d4;margin:8px 0;display:flex;justify-content:space-between;
  border-bottom:1px dashed rgba(255,255,255,.08);padding-bottom:7px}
.resultline b{color:var(--cyan);font-weight:400}
.bigend{font-size:clamp(34px,6vw,64px);letter-spacing:6px;line-height:1.1}
.logbox{max-height:190px;overflow:auto;font-size:11px;color:#7b8db0;line-height:1.9;margin-top:10px;
  border-left:2px solid rgba(0,240,255,.3);padding-left:12px}
.logbox div{white-space:pre-wrap}
.logbox .g{color:var(--lime)} .logbox .r{color:var(--red)} .logbox .y{color:var(--amber)} .logbox .c{color:var(--cyan)}
.helpgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px 26px;font-size:12px;color:#8fa3c4;line-height:1.9;margin-top:14px}
.helpgrid b{color:var(--cyan);font-weight:400}
.brandmark{display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:4px}
.brandmark canvas{display:block}
.brandmark .btxt{text-align:left}
.brandmark .bt1{font-size:clamp(30px,5.6vw,62px);letter-spacing:5px;line-height:1;font-weight:700}
.brandmark .bt2{font-size:clamp(11px,1.5vw,15px);letter-spacing:8px;color:var(--magenta);margin-top:7px}
.modebar{flex-basis:100%;display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px;
  padding:9px 12px;border:1px dashed rgba(176,38,255,.38);background:rgba(176,38,255,.07);
  clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px),calc(100% - 8px) 100%,0 100%,0 8px);}
.mbtn{padding:6px 14px;font:inherit;font-size:12px;letter-spacing:1px;cursor:pointer;
  border:1px solid #3a4a68;background:rgba(12,18,32,.8);color:#8fa3c4;transition:.15s}
.mbtn:hover{border-color:#b026ff;color:#d9b6ff}
.mbtn.on{border-color:var(--violet);color:#e6ccff;background:rgba(176,38,255,.2);box-shadow:0 0 14px rgba(176,38,255,.35)}
.mbtn.lock{opacity:.45;cursor:not-allowed}
.mtip{font-size:11px;color:#7b8db0;letter-spacing:1px}
.slot{font-size:11px;color:var(--violet);letter-spacing:1px;margin-left:6px}
.mktgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(268px,1fr));gap:13px;margin:18px 0}
.up{border:1px solid #2b3a55;background:rgba(12,18,32,.86);padding:13px 14px;cursor:pointer;transition:.16s;
  display:flex;flex-direction:column;gap:6px;
  clip-path:polygon(9px 0,100% 0,100% calc(100% - 9px),calc(100% - 9px) 100%,0 100%,0 9px);}
.up:hover:not(.maxed):not(.cant){border-color:var(--violet);transform:translateY(-3px);box-shadow:0 0 20px rgba(176,38,255,.24)}
.up.maxed{border-color:rgba(57,255,20,.5);opacity:.75;cursor:default}
.up.cant{opacity:.5;cursor:not-allowed}
.up .un{font-size:14px;letter-spacing:1px;color:#e6f0ff}
.up .ud{font-size:11px;color:#7b8db0;line-height:1.6}
.up .unx{font-size:11px;color:var(--lime);line-height:1.5}
.up .upc{font-size:13px;color:var(--violet);margin-top:auto;letter-spacing:1px}
.up .pips{display:flex;gap:4px;margin-top:2px}
.up .pips i{width:16px;height:5px;background:#1b2436;border:1px solid #34435f;display:block}
.up .pips i.on{background:var(--violet);border-color:#e0b8ff;box-shadow:0 0 8px rgba(176,38,255,.8)}
.shardbox{display:flex;align-items:center;gap:10px;padding:11px 16px;border:1px solid rgba(176,38,255,.45);
  background:rgba(176,38,255,.1);margin:14px 0;
  clip-path:polygon(10px 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%,0 10px);}
.shardbox .sv{font-size:26px;color:#d9b6ff;letter-spacing:2px;text-shadow:0 0 14px rgba(176,38,255,.8)}
.shardline{font-size:11px;color:#8fa3c4;letter-spacing:1px;line-height:1.8}

/* ---------- 难度 / 公司选择 ---------- */
.corpgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:24px 0 18px}
.corp{border:1px solid #2b3a55;background:rgba(12,18,32,.88);padding:0;cursor:pointer;transition:.18s;
  position:relative;overflow:hidden;text-align:left;font:inherit;color:inherit;
  clip-path:polygon(14px 0,100% 0,100% calc(100% - 14px),calc(100% - 14px) 100%,0 100%,0 14px);}
.corp:hover{transform:translateY(-5px)}
.corp .chd{padding:16px 18px 12px;border-bottom:1px solid rgba(255,255,255,.07);position:relative}
.corp .cno{font-size:10px;letter-spacing:4px;color:var(--dim)}
.corp .cn{font-size:18px;letter-spacing:2px;margin-top:5px;line-height:1.3}
.corp .cs{font-size:11px;color:#7b8db0;margin-top:4px;letter-spacing:1px}
.corp .cbd{padding:14px 18px 18px}
.corp .cd{font-size:12px;line-height:1.85;color:#93a6c6;min-height:76px}
.corp .cl{font-size:11px;line-height:1.7;margin-top:12px;color:#7b8db0}
.corp .cl b{font-weight:400}
.difbar{display:flex;align-items:center;gap:8px;font-size:10px;color:#6e809e;margin-top:7px;letter-spacing:1px}
.difbar .lb{width:52px;flex:none}
.difbar .tr{flex:1;height:5px;background:#141d30;position:relative;overflow:hidden}
.difbar .tr i{position:absolute;left:0;top:0;bottom:0;width:0;transition:width .5s ease}
.corp .go{margin-top:14px;display:flex;justify-content:space-between;align-items:center;font-size:11px;letter-spacing:2px}
.corp .best{font-size:10px;color:#5a6a85;letter-spacing:1px;margin-top:8px;min-height:14px}
.corp::after{content:"";position:absolute;inset:0;pointer-events:none;
  background:repeating-linear-gradient(0deg,rgba(255,255,255,.02) 0 1px,transparent 1px 3px)}
@media(max-width:860px){ .corpgrid{grid-template-columns:1fr} }
@media(max-width:900px){
  .bcol{width:200px;padding:12px}
  .helpgrid{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div id="app">

  <!-- ============ 标题 ============ -->
  <div id="screen-title" class="screen on">
